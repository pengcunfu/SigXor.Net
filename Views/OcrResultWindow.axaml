<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SigXor.OcrResultWindow"
        Title="OCR 识别结果"
        SystemDecorations="None"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="720"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       x:Name="TitleText"
                       Text="OCR 识别结果"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       PointerPressed="OnTitlePointerPressed"
                       Cursor="SizeAll"/>
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Content="✕"
                    Padding="10,3"
                    Click="OnCloseClick"/>
        </Grid>
        <TextBlock x:Name="StatusText"
                   Text="正在准备..."
                   Foreground="Gray"
                   FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="ResultText"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 MinHeight="120"
                 MaxHeight="240"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CopyButton" Content="复制" Padding="18,6" Click="OnCopyClick"/>
        </StackPanel>
    </StackPanel>
</Window>
